{
  "name": "My Racing Viewer",
  "short_name": "レース動画",
  "start_url": "./index.html",
  "display": "standalone",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "capture_links": "existing-client-navigate",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}